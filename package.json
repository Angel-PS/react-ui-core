{
  "name": "@angelps/react-ui-core",
  "version": "0.3.0",
  "description": "Librería de componentes React reutilizables",
  "author": "Angel",
  "license": "MIT",
  "main": "./dist/ui-core.cjs.js",
  "module": "./dist/ui-core.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/ui-core.es.js",
      "require": "./dist/ui-core.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": {
      "import": "./dist/style.css",
      "require": "./dist/style.css",
      "types": "./dist/styles.d.ts"
    }
  },
  "sideEffects": [
    "dist/style.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:watch": "vite build --watch",
    "lint": "eslint src --ext ts,tsx",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.2",
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-onboarding": "^10.3.3",
    "@storybook/addon-vitest": "^10.3.3",
    "@storybook/react-vite": "^10.3.3",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/browser-playwright": "^4.1.1",
    "@vitest/coverage-v8": "^4.1.1",
    "i": "^0.3.7",
    "jsdom": "^29.0.1",
    "npm": "^11.12.1",
    "playwright": "^1.58.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.3.3",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.1"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "library"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelps/react-ui-core.git"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "@react-input/mask": "^2.0.4",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  }
}
